{
  "name": "rep4rep-bot",
  "version": "0.0.3",
  "description": "Rep4Rep.com Automatic Comment Bot.",
  "main": "index.js",
  "dependencies": {
    "colors": "^1.4.0",
    "form-data": "^4.0.0",
    "moment": "^2.29.1",
    "node-fetch": "^2.0.0",
    "node-menu": "^1.3.0",
    "sqlite3": "6.0.1",
    "steam-totp": "^2.1.2",
    "steamcommunity": "^3.50.3",
    "steamid": "^2.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "check": "node --check index.js && node --check auto-relogin.js && npm run check:2fa",
    "check:2fa": "node --check steam-2fa/index.js && node --check steam-2fa/src/store.js && node --check steam-2fa/src/totp.js && node --check steam-2fa/scripts/enroll.js && node --check steam-2fa/scripts/finalize.js",
    "2fa:enroll": "node steam-2fa/scripts/enroll.js",
    "2fa:finalize": "node steam-2fa/scripts/finalize.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KniferFTW/rep4rep-bot.git"
  },
  "keywords": [
    "steam",
    "bot"
  ],
  "author": "Jesse (KniferFTW)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/KniferFTW/rep4rep-bot/issues"
  },
  "homepage": "https://github.com/KniferFTW/rep4rep-bot#readme",
  "overrides": {
    "request": {
      "form-data": "2.5.6",
      "qs": "6.16.0"
    }
  }
}
