[Unit]
Description=R4R Bot Auto Run
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
User=r4r
Group=r4r
WorkingDirectory=/opt/r4r-bot
Environment=NODE_ENV=production
Environment=R4R_CONFIG_FILE=/var/lib/r4r/config.json
Environment=R4R_DB_PATH=/var/lib/r4r/steamprofiles.db
Environment=R4R_2FA_DIR=/var/lib/r4r/auth
StateDirectory=r4r
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/node /opt/r4r-bot/index.js --auto

Restart=on-failure
RestartSec=5min

StandardInput=null
StandardOutput=journal
StandardError=journal

TimeoutStartSec=2h
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/r4r
