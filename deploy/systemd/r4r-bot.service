# R4R Bot - one Auto Run pass, started by r4r-bot.timer.
#
# EDIT BEFORE INSTALLING: replace USER, the project path and the Node.js path.
# Find your Node.js path with:  command -v node
# (with nvm it is something like /home/USER/.nvm/versions/node/vX.Y.Z/bin/node)

[Unit]
Description=R4R Bot Auto Run
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
User=USER
Group=USER
WorkingDirectory=/home/USER/apps/R4R-bot
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /home/USER/apps/R4R-bot/index.js --auto

Restart=on-failure
RestartSec=5min

StandardInput=null
StandardOutput=journal
StandardError=journal

TimeoutStopSec=30
KillSignal=SIGTERM

# Files created by the bot (steamprofiles.db, relogin state) are private to USER.
UMask=0077

# Hardening. The bot only needs outbound network access and write access to its
# own directory and ~/.config/r4r. After editing paths, run:
#   systemd-analyze security r4r-bot.service
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/home/USER/apps/R4R-bot /home/USER/.config/r4r
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
